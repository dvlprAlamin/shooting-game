<?xml version="1.0" encoding="utf-8"?>
<!-- Plain ws:// to this phone only: a nearby game's server and tunnels listen on 127.0.0.1 (lan/LanPlugin.java).
     Everything else stays https:// / wss://. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
