{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shooting-game",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  // One Durable Object per game room, looked up by room id, and one Lobby for quick play.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "LOBBY", "class_name": "Lobby" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Lobby"] }
  ],
  // Player profiles. No database_id: `wrangler deploy` provisions the database the first time (it creates its own
  // table, see src/profiles.js). The game runs without it, minus profiles.
  "d1_databases": [{ "binding": "DB", "database_name": "shooting-game" }],
  // Spam protection (src/app.js): requests per client address per minute, counted per Cloudflare location. Room
  // connections include reconnects (up to 5 per dropped connection). namespace_id only has to be unique on the
  // account; bindings sharing one share counts.
  "ratelimits": [
    { "name": "LIMIT_ROOMS", "namespace_id": "7301", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMIT_QUICKPLAY", "namespace_id": "7302", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIMIT_PROFILE", "namespace_id": "7303", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMIT_AUTH", "namespace_id": "7304", "simple": { "limit": 20, "period": 60 } }
  ],
  // The address the apps use for now (VITE_SERVER_URL in apps/client/.env.production).
  "workers_dev": true,
  "vars": {
    // Sign in with Google: the Web OAuth client id from Google Cloud, the same one as VITE_GOOGLE_WEB_CLIENT_ID in
    // the client (comma-separated for several, the Web one first: /delete-account signs in with it). Not a secret.
    // Empty: sign-in is off.
    "GOOGLE_CLIENT_ID": "378969469504-154hsjlr8fbni6481c6km1c9794pjd5d.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
