{
  "name": "rimfire",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @rimfire/client --filter @rimfire/server dev",
    "dev:client": "pnpm --filter @rimfire/client dev",
    "dev:server": "pnpm --filter @rimfire/server dev",
    "build": "pnpm --filter @rimfire/client build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "deploy:server": "pnpm --filter @rimfire/server run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  }
}
