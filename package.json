{
  "name": "rimfire",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @rimfire/client --filter @rimfire/server dev",
    "dev:client": "pnpm --filter @rimfire/client dev",
    "dev:server": "pnpm --filter @rimfire/server dev",
    "build": "pnpm --filter @rimfire/client build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "deploy:server": "pnpm --filter @rimfire/server run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "eslint": "^9.8.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
